const prefersReducedMotion =
window.matchMedia(
'(prefers-reduced-motion: reduce)'
).matches;

/* =========================
   Reveal
========================= */

function setupRevealObserver(){

const fadeNodes =
document.querySelectorAll('.fade');

if(prefersReducedMotion){

fadeNodes.forEach(node=>
node.classList.add('show')
);

return;
}

const observer =
new IntersectionObserver(entries=>{

entries.forEach(entry=>{

if(entry.isIntersecting){

entry.target.classList.add(
'show'
);

observer.unobserve(
entry.target
);

}

});

},{
threshold:.16,
rootMargin:"0px 0px -8% 0px"
});

fadeNodes.forEach(node=>
observer.observe(node)
);

}

/* =========================
   页面切换
========================= */

function setupPageTransition(){

const overlay =
document.createElement('div');

overlay.className =
'page-transition-overlay';

document.body.appendChild(
overlay
);

requestAnimationFrame(()=>{

document.body.classList.add(
'page-ready'
);

});

}

/* =========================
   锚点滚动
========================= */

function setupAnchorScroll(){

document
.querySelectorAll(
'a[href^="#"]'
)
.forEach(link=>{

link.addEventListener(
'click',
e=>{

e.preventDefault();

const target =
document.querySelector(
link.getAttribute(
'href'
)
);

if(!target) return;

const offset =
100;

window.scrollTo({

top:
target.offsetTop-offset,

behavior:
'smooth'

});

});

});

}

/* =========================
   记忆碎片
========================= */

function setupMemoryShards(){

const buttons =
document.querySelectorAll(
'.memory-shard'
);

const panels =
document.querySelectorAll(
'.memory-panel'
);

buttons.forEach(btn=>{

btn.addEventListener(
'click',
()=>{

const key =
btn.dataset.memory;

buttons.forEach(b=>
b.classList.remove(
'active'
)
);

btn.classList.add(
'active'
);

panels.forEach(panel=>{

panel.classList.toggle(
'active',
panel.dataset.panel===key
);

});

});

});

}

/* =========================
   唐姝同行数据库
========================= */

const dialogueData = {

  embroidery:{
    image:"images/dialogue-portrait.jpg",
    alt:"蹙金绣"
  },

  makeup:{
    image:"images/dialogue-portrait.jpg",
    alt:"花钿妆"
  },

  incense:{
    image:"images/dialogue-portrait.jpg",
    alt:"香艺"
  }

};

/* =========================
   对话系统
========================= */

function setupDialogueSystem(){

const tabs =
document.querySelectorAll(
'.dialogue-tab'
);

const image =
document.getElementById(
'dialogueImage'
);

const messages =
document.getElementById(
'dialogueMessages'
);

const input =
document.getElementById(
'dialogueInput'
);

const sendBtn =
document.getElementById(
'sendBtn'
);

function addMessage(role,text){

const div =
document.createElement('div');

div.className =
`message ${role}-message`;

div.innerHTML=`

<span class="bubble-label">
${role==="ai"?"唐姝":"用户"}
</span>

<div class="bubble">
${text}
</div>

`;

messages.appendChild(div);

messages.scrollTop =
messages.scrollHeight;

}

function loadDialogue(type){

const data =
dialogueData[type];

image.classList.add(
'switching'
);

setTimeout(()=>{

image.src =
data.image;

image.alt =
data.alt;

image.classList.remove(
'switching'
);

},300);

messages.innerHTML="";

data.welcome.forEach(item=>{

addMessage(
item.role,
item.text
);

});

}

tabs.forEach(tab=>{

tab.addEventListener(
'click',
()=>{

tabs.forEach(t=>
t.classList.remove(
'active'
)
);

tab.classList.add(
'active'
);

loadDialogue(
tab.dataset.dialogue
);

});

});

sendBtn.addEventListener(
'click',
sendMessage
);

input.addEventListener(
'keydown',
e=>{

if(
e.key==="Enter"
&&
!e.shiftKey
){

e.preventDefault();

sendMessage();

}

});

function sendMessage(){

const text =
input.value.trim();

if(!text) return;

addMessage(
'user',
text
);

input.value='';

setTimeout(()=>{

addMessage(
'ai',
'唐姝正在整理相关非遗记忆，并将于后续接入 DeepSeek 智能问答。'
);

},700);

}

loadDialogue(
'embroidery'
);

}

/* =========================
   场景切换
========================= */

function setupSceneTabs(){

const tabs =
document.querySelectorAll(
'.scene-tab'
);

const panels =
document.querySelectorAll(
'.scene-panel'
);

tabs.forEach(tab=>{

tab.addEventListener(
'click',
()=>{

const target =
tab.dataset.scene;

tabs.forEach(t=>
t.classList.remove(
'active'
)
);

tab.classList.add(
'active'
);

panels.forEach(panel=>{

panel.classList.toggle(
'active',
panel.dataset.scenePanel===target
);

});

});

});

}

/* =========================
   初始化
========================= */

/* 鼠标跟踪高光效果 */
const setupCursorGlow = () => {
  console.log('setupCursorGlow called');
  const glow = document.querySelector('.cursor-glow');
  console.log('glow element:', glow);
  if (!glow) return;
  
  let mouseX = 0, mouseY = 0;
  let glowX = 0, glowY = 0;
  
  document.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    glow.style.opacity = '1';
  });
  
  document.addEventListener('mouseleave', () => {
    glow.style.opacity = '0';
  });
  
  const updateGlow = () => {
    glowX += (mouseX - glowX) * 0.08;
    glowY += (mouseY - glowY) * 0.08;
    glow.style.left = glowX + 'px';
    glow.style.top = glowY + 'px';
    requestAnimationFrame(updateGlow);
  };
  
  updateGlow();
};

document.addEventListener(
'DOMContentLoaded',
()=>{

setupRevealObserver();

setupPageTransition();

setupAnchorScroll();

setupMemoryShards();

setupDialogueSystem();

setupSceneTabs();

setupCursorGlow();

}
);